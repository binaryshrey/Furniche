# Copy to .env.local and fill in. Keys come from /costar-keys in the HackPrinceton Discord.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
# Optional: Claude for the AI stylist and product import. Without it both use rule-based fallbacks.
# Photo to 3D also uses it to name a photographed piece and estimate its size.
ANTHROPIC_API_KEY=
# Optional: Capital One Nessie v2 key for the move-in budget and sandbox checkout. Without it, demo numbers are used.
NESSIE_API_KEY=
# Optional: Photon 2.0 beta, so the assistant also answers on iMessage. PHOTON_API_KEY is the pho_sk_ secret key.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Optional, free: a Hugging Face read token (https://huggingface.co/settings/tokens) for Photo to 3D.
# It works without one; a free account's token raises the daily free GPU allowance.
HF_TOKEN=
# Optional, free: your own GPU for Photo to 3D, with no daily limits. Run scripts/photo3d_gpu.ipynb on
# Kaggle (or Colab) and paste the two lines it prints.
PHOTO3D_GPU_URL=
PHOTO3D_GPU_TOKEN=
